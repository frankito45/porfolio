<section id="contacto" class=" py-24 text-white">
  <div class="mx-auto max-w-4xl px-6 text-center">

    <p class="text-sm uppercase tracking-[0.3em] text-gray-500">
      ¿Hablamos?
    </p>

    <h2 class="mt-4 text-4xl font-bold">
      Contactame
    </h2>

    <p class="mx-auto mt-5 max-w-lg text-gray-400 leading-7">
      Si tenés un proyecto, una consulta o simplemente querés conocer
      más sobre mi trabajo, podés escribirme.
    </p>


    <form
      action="/api/gmail"
      method="POST"
      class="mx-auto mt-10 flex max-w-2xl flex-col gap-5 rounded-2xl border border-zinc-800 bg-zinc-950/70 p-6 text-left shadow-2xl shadow-black/20 sm:p-8">
      <div>
        <label for="to" class="block text-sm font-medium text-zinc-300">
          Correo electrónico
        </label>
        <input
          type="email"
          id="to"
          name="to"
          class="mt-2 block w-full rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3 text-white transition placeholder:text-zinc-500 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-400/20"
          placeholder="tu-correo@gmail.com"
        />
      </div>

      <div>
        <label for="body" class="block text-sm font-medium text-zinc-300">
          Mensaje
        </label>
        <textarea
          id="body"
          name="body"
          rows={4}
          class="mt-2 block w-full resize-y rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3 text-white transition placeholder:text-zinc-500 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-400/20"
          placeholder="Escribe tu mensaje aquí..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-3 self-start rounded-full
               border border-violet-400 px-7 py-3 font-medium text-violet-300
               transition duration-300 hover:bg-violet-400 hover:text-black
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
      >
        Enviar correo
      </button>
    </form>


    <div class="mt-12 flex justify-center gap-8 text-sm text-gray-500">

      <a
        href="#"
        class="transition hover:text-white"
      >
        GitHub
      </a>

      <a
        href="#"
        class="transition hover:text-white"
      >
        LinkedIn
      </a>

      <a
        href="#"
        class="transition hover:text-white"
      >
        WhatsApp
      </a>

    </div>

  </div>
</section>