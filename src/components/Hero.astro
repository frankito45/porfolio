---

interface Props {
titulo: string;
sobreMi: string;
img: string;
}

const { titulo, sobreMi, img } = Astro.props;
---
<section
    id="inicio"
    class="flex min-h-[calc(100vh-80px)] flex-col justify-center px-5 py-16 md:px-8"
>
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 md:flex-row md:items-center md:justify-between">


    <!-- Texto -->
    <div class="max-w-2xl">
        <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-zinc-500">
            Portfolio
        </p>

        <h2
            class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
        >
            {titulo}
        </h2>

        <p class="mt-6 max-w-xl text-base leading-7 text-zinc-400 sm:text-lg">
            {sobreMi}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
            <a
                href="#proyectos"
                class="rounded-full bg-white px-6 py-3 text-sm font-medium text-black transition hover:bg-zinc-200"
            >
                Ver proyectos
            </a>

            <a
                href="#contacto"
                class="rounded-full border border-zinc-800 px-6 py-3 text-sm text-zinc-300 transition hover:border-zinc-600 hover:text-white"
            >
                Contactarme
            </a>
        </div>
    </div>

    <!-- Imagen -->
    <div class="flex justify-center md:justify-end">
        <div class="relative">
            <div
                class="absolute -inset-2 -z-10 rounded-full bg-zinc-800/40 blur-2xl"
            ></div>

            <img
                src={img}
                alt="Franco Mancilla"
                class="h-52 w-52 rounded-full object-cover transition duration-500 hover:grayscale-0 sm:h-64 sm:w-64"
            />
        </div>
    </div>

</div>


</section>
