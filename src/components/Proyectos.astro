---
import ProyectCard from "./card/ProyectCard.astro";

import { getCollection } from 'astro:content';
const projects = await getCollection('projects');

---

<section id="proyectos" class="px-5 py-20 md:px-8">
    <div class="mx-auto max-w-6xl">
        <p class="text-sm uppercase tracking-[0.2em] text-zinc-500">
            Proyectos
        </p>

        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
            Cosas que he construido
        </h2>

        
        <div class="mx-auto mt-10 grid w-full max-w-4xl grid-cols-1 gap-6  md:grid-cols-2">
    

            {
                projects.map((project) => (
                    <a href={`/projects/${project.id}`}>
                    <ProyectCard
                        titulo={project.data.title}
                        descripcion={project.data.description}
                        img={project.data.image || 'src/assets/image.png'}
                        imgDescripcion={project.data.title}
                    />
                </a>
                ))
            }


        </div>
    </div>
</section>