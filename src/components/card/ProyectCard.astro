---
interface Props {
    img: string
    imgDescripcion:string
    titulo:string
    descripcion:string
}

const neonColors = [
    "#00ffff",
    "#ff00ff",
    "#8a2be2",
    "#00ff88",
    "#0088ff",
    "#ffff00",
]

const neon = neonColors[Math.floor(Math.random() * neonColors.length)]

const { titulo, descripcion, img ,imgDescripcion } = Astro.props;
---
<div style={`--neon: ${neon}`}
    class="group rounded-2xl border border-zinc-800 bg-white/1 p-3 backdrop-blur-md transition-all duration-500 hover:-translate-y-1 hover:border-(--neon)/50 hover:bg-(--neon)/5 hover:shadow-[0_0_20px_color-mix(in_srgb,var(--neon)_40%,transparent)]"
>
    <div class="overflow-hidden rounded-xl">
        <img
            src={img}
            alt={imgDescripcion}
            class="h-52 w-full rounded-xl object-cover transition duration-500 group-hover:scale-105"
        />
    </div>

    <div class="px-2 pb-2 pt-4">
        <h2 class="text-xl font-semibold text-white group-hover:text-(--neon)">
            {titulo}
        </h2>

        <p class="mt-2 text-sm leading-6 text-zinc-400">
            {descripcion}
        </p>
    </div>
</div>