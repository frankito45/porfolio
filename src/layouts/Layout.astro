---

import "../styles/global.css";
import 'katex/dist/katex.min.css';
interface Props {
    title?: string;
    description: string
}

const { 
    title = "Franco Mancilla",
    description = "Portfolio de Franco Mancilla, Full Stack Developer freelance especializado en desarrollo web."
} = Astro.props;

---

<!doctype html>
<html lang="es">
    <head>
		<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
  crossorigin="anonymous"
/>
        <meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
 <meta name="description" content={description} />
  <meta name="author" content="Franco Mancilla" />
   <meta name="robots" content="index, follow" />
   <meta name="msvalidate.01" content="3D4CFFF4E8C378B720910E5908432F02" />
        <title>{title}</title>
    </head>

    <body>
        <slot />
    </body>
</html>